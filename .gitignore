# Python caches and build artifacts
__pycache__/
*.py[cod]
*.egg-info/
.build/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Virtual environments and local configuration
.venv/
venv/
env/
.env
.env.*

# IDE and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db
*.Zone.Identifier
*:Zone.Identifier

# Large or generated geospatial artifacts
*.fgb
*.geojson
*.gpkg
*.mbtiles
