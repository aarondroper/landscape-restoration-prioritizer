*.tiff

# Project data directories are intentionally kept out of Git.
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
data/derived/*

# Frontend dependencies, build output, and generated delivery copies
web/node_modules/
web/dist/
web/public/data/candidates.geojson
web/public/data/candidates.metadata.json
web/public/data/candidate_shortlists.json
web/public/data/presets.json
web/public/data/candidate_weight_index.json
